---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { CHAPTERS } from '../../data/chapters';

const articles = await getCollection('articles');
// Sort newest first
articles.sort((a, b) => (b.data.publishDate || '').localeCompare(a.data.publishDate || ''));

const pageTitle = 'Articles & Vignettes';
const description = 'Standalone pieces that pair with the encyclopedia — teasers, vignettes, and companion articles that open into chapters and datasets.';
---

<BaseLayout title={pageTitle} description={description}>
  <div class="articles-index">
    <header class="articles-hero">
      <h1>Articles &amp; Vignettes</h1>
      <p class="lede">{description}</p>
    </header>

    {articles.length === 0 ? (
      <p class="empty">No articles yet. Check back soon.</p>
    ) : (
      <div class="article-list">
        {articles.map((article) => {
          const ch = article.data.companionToChapter
            ? CHAPTERS.find(c => c.number === article.data.companionToChapter)
            : null;
          return (
            <a href={`/articles/${article.id}/`} class="article-card">
              <div class="article-card__kind">
                {article.data.kind ?? 'Article'}
                {ch && <span class="article-card__ch"> · Ch{article.data.companionToChapter}: {ch.title}</span>}
              </div>
              <h2 class="article-card__title">{article.data.title}</h2>
              <p class="article-card__description">{article.data.description}</p>
              <div class="article-card__meta">
                {article.data.readingTime}
                {article.data.publishDate && ` · ${article.data.publishDate}`}
              </div>
            </a>
          );
        })}
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .articles-index {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 2rem;
  }
  .articles-hero { margin-bottom: 2.5rem; }
  .articles-hero h1 {
    font-family: 'Libre Baskerville', serif;
    font-size: 2.5rem;
    margin: 0 0 0.75rem;
  }
  .lede {
    font-size: 1.125rem;
    color: var(--color-text-muted, #555);
    line-height: 1.6;
    max-width: 65ch;
    margin: 0;
  }
  .empty {
    padding: 3rem 0;
    color: var(--color-text-muted, #777);
    text-align: center;
  }
  .article-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .article-card {
    display: block;
    padding: 1.5rem;
    background: #fff;
    border: 1px solid var(--color-border-light, #e5e5e5);
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .article-card:hover {
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
    transform: translateY(-1px);
  }
  .article-card__kind {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent-primary, #C85A54);
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  .article-card__ch {
    color: var(--color-text-muted, #777);
    font-weight: normal;
  }
  .article-card__title {
    font-family: 'Libre Baskerville', serif;
    font-size: 1.375rem;
    margin: 0 0 0.5rem;
    line-height: 1.3;
  }
  .article-card__description {
    margin: 0 0 0.75rem;
    color: var(--color-text-muted, #555);
    line-height: 1.5;
  }
  .article-card__meta {
    font-size: 0.8125rem;
    color: var(--color-text-muted, #777);
  }
  @media (max-width: 640px) {
    .articles-index { padding: 2rem 1rem; }
    .articles-hero h1 { font-size: 1.75rem; }
  }
</style>
