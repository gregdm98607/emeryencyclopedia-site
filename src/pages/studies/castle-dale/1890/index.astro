---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getStudy } from '../../../../data/studies';
import {
  RECONSTRUCTIONS,
  STYLE_LABEL,
  STYLE_BLURB,
  SOURCE_MAPS,
  type ReconstructionStyle,
} from '../../../../data/castle-dale-1890';

const study = getStudy('castle-dale')!;
const title = 'Castle Dale, 1890: Four Reconstructions';
const description =
  'Four interactive 3-D reconstructions of Castle Dale, Utah, as it may have looked in 1890 — two photographic, two simulation-style — built from the 1880 townsite plat, the 1917 Sanborn map, and later surveys.';

const styles: ReconstructionStyle[] = ['photographic', 'simulation'];
const models = [...new Set(RECONSTRUCTIONS.map((r) => r.model))];
const cell = (style: ReconstructionStyle, model: string) =>
  RECONSTRUCTIONS.find((r) => r.style === style && r.model === model)!;
---

<BaseLayout title={title} description={description} image="/images/studies/castle-dale-1890/og.jpg">
  <article class="folio">
    <!-- ── Title sheet ─────────────────────────────────────────── -->
    <header class="sheet">
      <div class="sheet__bg" aria-hidden="true"></div>
      <svg class="sheet__grid" aria-hidden="true" preserveAspectRatio="none">
        <defs>
          <pattern id="plat" width="64" height="64" patternUnits="userSpaceOnUse">
            <path d="M64 0H0V64" fill="none" stroke="currentColor" stroke-width="0.6" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#plat)" />
      </svg>

      <div class="sheet__inner">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span>
          <a href="/studies/">One Place Studies</a><span>/</span>
          <a href={`/studies/${study.slug}/`}>{study.shortLabel}</a><span>/</span>
          <span aria-current="page">1890 Reconstructions</span>
        </nav>

        <p class="sheet__eyebrow">{study.title} &middot; Maps</p>
        <h1 class="sheet__title">
          Castle Dale,<br /><span>1890</span>
        </h1>
        <p class="sheet__lede">
          Ten years after the townsite was surveyed, and two years before the county built its brick
          courthouse, what did Castle Dale look like? Nobody photographed it from above. These four
          interactive models are an attempt to see it anyway &mdash; the same town, rebuilt four ways
          from the surviving maps.
        </p>
        <dl class="sheet__coords">
          <div><dt>Lat.</dt><dd>39&deg;12&prime; N</dd></div>
          <div><dt>Long.</dt><dd>111&deg;01&prime; W</dd></div>
          <div><dt>Elev.</dt><dd>&asymp; 5,660 ft</dd></div>
          <div><dt>Plates</dt><dd>I&ndash;IV</dd></div>
        </dl>
        <a class="sheet__jump" href="#plates">View the plates <span aria-hidden="true">&darr;</span></a>
      </div>
    </header>

    <!-- ── Reading notes ───────────────────────────────────────── -->
    <section class="notes" aria-labelledby="notes-h">
      <div class="notes__text">
        <h2 id="notes-h">How to read these models</h2>
        <p>
          Each reconstruction lays the town&rsquo;s 1880 street grid over real terrain, then fills the
          blocks with houses, gardens, ditches, and fields as they plausibly stood in 1890. The grid and
          a handful of dated buildings are documented. Most individual houses, fences, and crops are
          <em>informed interpretation</em> &mdash; representative, not recorded.
        </p>
        <p>
          The four versions form a deliberate comparison: two rendering styles, each built with two
          different AI models working from the same source maps. Where they agree, the evidence is
          doing the work. Where they differ, you are looking at interpretation.
        </p>
        <p class="notes__caveat">
          These are research sketches, not photographs. Each model has an &ldquo;About&rdquo; or
          &ldquo;Field notes&rdquo; panel explaining what is documented and what is inferred.
        </p>
      </div>

      <aside class="index" aria-label="Source maps">
        <h3 class="index__h">Sheet index &mdash; sources</h3>
        <ol class="index__list">
          {SOURCE_MAPS.map((s, i) => (
            <li>
              <span class="index__n">{String(i + 1).padStart(2, '0')}</span>
              <span class="index__body">
                <strong>{s.title}</strong>
                <span class="index__date">{s.date}</span>
                <span class="index__note">{s.note}</span>
              </span>
            </li>
          ))}
        </ol>
      </aside>
    </section>

    <!-- ── The folio: a 2×2 comparison of plates ───────────────── -->
    <section id="plates" class="plates" aria-labelledby="plates-h">
      <h2 id="plates-h" class="plates__h">The Plates</h2>
      <p class="plates__sub">Read across to compare AI models; read down to compare styles.</p>

      <div class="matrix" style={`--cols: ${models.length}`}>
        <div class="matrix__corner" aria-hidden="true"></div>
        {models.map((m) => (
          <div class="matrix__colhead" aria-hidden="true">
            <span class="matrix__kicker">Built with</span>{m}
          </div>
        ))}

        {styles.map((style) => (
          <>
            <div class="matrix__rowhead" aria-hidden="true">
              <span class="matrix__rowlabel">{STYLE_LABEL[style]}</span>
              <span class="matrix__rowblurb">{STYLE_BLURB[style]}</span>
            </div>
            {models.map((model) => {
              const r = cell(style, model);
              const viewer = `/studies/castle-dale/1890/${r.slug}/`;
              return (
                <article class="plate">
                  <a class="plate__frame" href={viewer} tabindex="-1" aria-hidden="true">
                    <img
                      src={`/images/studies/castle-dale-1890/${r.slug}.webp`}
                      alt=""
                      width="960"
                      height="600"
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="plate__tick plate__tick--tl"></span>
                    <span class="plate__tick plate__tick--tr"></span>
                    <span class="plate__tick plate__tick--bl"></span>
                    <span class="plate__tick plate__tick--br"></span>
                    <span class="plate__enter">Enter the model &rarr;</span>
                  </a>
                  <div class="plate__meta">
                    <span class="plate__num">Plate {r.plate}</span>
                    <span class="plate__tags">
                      {STYLE_LABEL[r.style]} &middot; {r.model}
                    </span>
                  </div>
                  <h3 class="plate__title">
                    <a href={viewer}>{r.title}</a>
                  </h3>
                  <p class="plate__desc">{r.description}</p>
                  <ul class="plate__try">
                    {r.highlights.map((h) => <li>{h}</li>)}
                  </ul>
                  <div class="plate__actions">
                    <a class="btn btn--primary" href={viewer}>Explore Plate {r.plate}</a>
                    <a class="btn btn--ghost" href={`/maps/castle-dale-1890/${r.slug}.html`} target="_blank" rel="noopener">
                      Full screen <span aria-hidden="true">&#8599;</span>
                    </a>
                    <span class="plate__weight">{r.weight}</span>
                  </div>
                </article>
              );
            })}
          </>
        ))}
      </div>

      <p class="plates__tip">
        Best on a laptop or desktop. On a phone, rotate to landscape and use one finger to turn, two to
        zoom.
      </p>
    </section>

    <!-- ── Onward ──────────────────────────────────────────────── -->
    <nav class="onward" aria-label="Related">
      <a class="onward__card" href={`/studies/${study.slug}/`}>
        <span class="onward__k">Back to the study</span>
        <span class="onward__t">{study.title}</span>
      </a>
      <a class="onward__card" href="/articles/castle-dale-1880/">
        <span class="onward__k">Ten years earlier</span>
        <span class="onward__t">Castle Dale, 1880</span>
      </a>
      <a class="onward__card" href="/data/castle-dale-1880/">
        <span class="onward__k">The people</span>
        <span class="onward__t">1880 Census of Castle Dale</span>
      </a>
    </nav>
  </article>
</BaseLayout>

<style>
  .folio {
    --ink: var(--canyon-shadow);
    --paper: var(--sky-wash);
    --rule: color-mix(in srgb, var(--canyon-bronze) 45%, transparent);
    --accent: var(--mesa-red);
  }

  /* ── Title sheet ── */
  .sheet {
    position: relative;
    overflow: hidden;
    background: var(--coal-seam);
    color: var(--sky-wash);
    isolation: isolate;
  }
  .sheet__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(100deg, var(--coal-seam) 18%, color-mix(in srgb, var(--coal-seam) 55%, transparent) 55%, color-mix(in srgb, var(--coal-seam) 20%, transparent)),
      url('/images/studies/castle-dale-1890/og.jpg') right center / cover no-repeat;
    filter: sepia(0.35) saturate(0.85);
    transform: scale(1.04);
    animation: drift 24s ease-in-out infinite alternate;
  }
  .sheet__grid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    color: var(--sandstone);
    opacity: 0.14;
  }
  .sheet__inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 2rem 2rem 4.5rem;
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: var(--text-xs);
    color: color-mix(in srgb, var(--sky-wash) 70%, transparent);
    margin-bottom: 3.5rem;
  }
  .crumbs a { color: var(--sandstone); text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }

  .sheet__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--sandstone);
    margin-bottom: 1rem;
  }
  .sheet__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.75rem, 7vw, 5.5rem);
    line-height: 0.98;
    letter-spacing: -0.01em;
    color: var(--sky-wash);
    margin-bottom: 1.5rem;
  }
  .sheet__title span {
    font-style: italic;
    color: var(--sandstone);
  }
  .sheet__lede {
    max-width: 38rem;
    font-size: var(--text-md);
    line-height: 1.6;
    color: color-mix(in srgb, var(--sky-wash) 88%, transparent);
    margin-bottom: 2.25rem;
  }
  .sheet__coords {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    border-top: 1px solid color-mix(in srgb, var(--sandstone) 40%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--sandstone) 40%, transparent);
    width: fit-content;
    max-width: 100%;
    margin-bottom: 2rem;
  }
  .sheet__coords div {
    padding: 0.6rem 1.4rem 0.6rem 0;
    margin-right: 1.4rem;
    border-right: 1px solid color-mix(in srgb, var(--sandstone) 25%, transparent);
  }
  .sheet__coords div:last-child { border-right: 0; margin-right: 0; }
  .sheet__coords dt {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--sky-wash) 55%, transparent);
  }
  .sheet__coords dd {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--sky-wash);
  }
  .sheet__jump {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    font-weight: 600;
    color: var(--coal-seam);
    background: var(--sandstone);
    padding: 0.7rem 1.25rem;
    border-radius: 2px;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
  }
  .sheet__jump:hover { background: var(--sky-wash); transform: translateY(-1px); }

  .sheet__inner > * {
    opacity: 0;
    animation: rise 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
  }
  .sheet__inner > :nth-child(2) { animation-delay: 0.08s; }
  .sheet__inner > :nth-child(3) { animation-delay: 0.16s; }
  .sheet__inner > :nth-child(4) { animation-delay: 0.26s; }
  .sheet__inner > :nth-child(5) { animation-delay: 0.36s; }
  .sheet__inner > :nth-child(6) { animation-delay: 0.46s; }

  @keyframes rise {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes drift {
    from { transform: scale(1.04) translateX(0); }
    to { transform: scale(1.08) translateX(-1.5%); }
  }

  /* ── Reading notes ── */
  .notes {
    max-width: 1180px;
    margin: 0 auto;
    padding: 4rem 2rem 1rem;
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 3.5rem;
    align-items: start;
  }
  .notes h2 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
    margin-bottom: 1.25rem;
  }
  .notes p { margin-bottom: 1rem; max-width: 62ch; }
  .notes__caveat {
    font-size: var(--text-sm);
    color: var(--color-muted-text);
    border-left: 3px solid var(--accent);
    padding-left: 1rem;
  }

  .index {
    border: 1px solid var(--rule);
    background:
      repeating-linear-gradient(0deg, transparent 0 31px, color-mix(in srgb, var(--canyon-bronze) 10%, transparent) 31px 32px),
      var(--paper);
    padding: 1.25rem 1.4rem 0.5rem;
    position: relative;
  }
  .index::before {
    content: '';
    position: absolute;
    inset: 5px;
    border: 1px solid color-mix(in srgb, var(--canyon-bronze) 25%, transparent);
    pointer-events: none;
  }
  .index__h {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--canyon-bronze);
    margin-bottom: 0.75rem;
  }
  .index__list { list-style: none; }
  .index__list li {
    display: flex;
    gap: 0.9rem;
    padding: 0.75rem 0;
    border-top: 1px dashed var(--rule);
  }
  .index__n {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
    padding-top: 0.15rem;
  }
  .index__body { display: flex; flex-direction: column; line-height: 1.35; }
  .index__body strong { font-family: var(--font-display); font-weight: 700; font-size: 0.95rem; }
  .index__date { font-family: var(--font-mono); font-size: 0.75rem; color: var(--canyon-bronze); margin: 0.15rem 0; }
  .index__note { font-size: var(--text-xs); color: var(--color-muted-text); }

  /* ── Plates ── */
  .plates {
    max-width: 1180px;
    margin: 0 auto;
    padding: 3.5rem 2rem 2rem;
  }
  .plates__h {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 400;
    font-style: italic;
    text-align: center;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .plates__h::before,
  .plates__h::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--rule);
  }
  .plates__sub {
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--color-muted-text);
    margin: 0.5rem 0 2.5rem;
  }

  .matrix {
    display: grid;
    grid-template-columns: 3.25rem repeat(var(--cols), minmax(0, 1fr));
    column-gap: 2rem;
    row-gap: 0;
  }
  .matrix__corner { border-bottom: 2px solid var(--ink); }
  .matrix__colhead {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 700;
    padding: 0 0 0.75rem;
    border-bottom: 2px solid var(--ink);
  }
  .matrix__kicker {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--canyon-bronze);
    margin-bottom: 0.2rem;
  }
  .matrix__rowhead {
    position: relative;
    border-right: 1px solid var(--rule);
    padding: 2rem 0;
  }
  .matrix__rowlabel {
    position: sticky;
    top: 5.5rem;
    display: block;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 auto;
  }
  .matrix__rowblurb { display: none; }

  .plate {
    padding: 2rem 0 2.5rem;
    border-bottom: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    opacity: 0;
    animation: rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
    animation-timeline: view();
    animation-range: entry 0% entry 40%;
  }
  @supports not (animation-timeline: view()) {
    .plate { opacity: 1; animation: none; }
  }

  .plate__frame {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--alkali-flat);
    outline: 1px solid var(--rule);
    outline-offset: 6px;
    margin: 6px;
  }
  .plate__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1), filter 0.4s;
    filter: saturate(0.92);
  }
  .plate__frame:hover img { transform: scale(1.045); filter: saturate(1.05); }

  .plate__tick {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: var(--sky-wash);
    border-style: solid;
    border-width: 0;
    mix-blend-mode: difference;
  }
  .plate__tick--tl { top: 10px; left: 10px; border-top-width: 2px; border-left-width: 2px; }
  .plate__tick--tr { top: 10px; right: 10px; border-top-width: 2px; border-right-width: 2px; }
  .plate__tick--bl { bottom: 10px; left: 10px; border-bottom-width: 2px; border-left-width: 2px; }
  .plate__tick--br { bottom: 10px; right: 10px; border-bottom-width: 2px; border-right-width: 2px; }

  .plate__enter {
    position: absolute;
    left: 50%;
    bottom: 1rem;
    transform: translate(-50%, 8px);
    opacity: 0;
    background: var(--coal-seam);
    color: var(--sky-wash);
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 0.45rem 0.9rem;
    border-radius: 2px;
    transition: opacity 0.25s, transform 0.25s;
    white-space: nowrap;
  }
  .plate__frame:hover .plate__enter { opacity: 1; transform: translate(-50%, 0); }

  .plate__meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin: 1.4rem 0 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .plate__num { color: var(--accent); font-weight: 400; }
  .plate__tags { color: var(--color-muted-text); text-align: right; }

  .plate__title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: var(--leading-tight);
    margin-bottom: 0.6rem;
  }
  .plate__title a { color: var(--ink); text-decoration: none; background-image: linear-gradient(var(--accent), var(--accent)); background-size: 0 1px; background-position: 0 100%; background-repeat: no-repeat; transition: background-size 0.3s; }
  .plate__title a:hover { background-size: 100% 1px; }

  .plate__desc { font-size: var(--text-sm); line-height: 1.6; margin-bottom: 0.9rem; }

  .plate__try {
    list-style: none;
    font-size: var(--text-xs);
    color: var(--color-muted-text);
    margin-bottom: 1.4rem;
  }
  .plate__try li {
    position: relative;
    padding-left: 1.2rem;
    margin-bottom: 0.3rem;
    line-height: 1.45;
  }
  .plate__try li::before {
    content: '';
    position: absolute;
    left: 0.15rem;
    top: 0.5em;
    width: 6px;
    height: 6px;
    border: 1px solid var(--accent);
    transform: rotate(45deg);
  }

  .plate__actions {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 0.55rem 1rem;
    border-radius: 2px;
    text-decoration: none;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .btn--primary { background: var(--ink); color: var(--sky-wash); border: 1px solid var(--ink); }
  .btn--primary:hover { background: var(--accent); border-color: var(--accent); }
  .btn--ghost { color: var(--ink); border: 1px solid var(--rule); }
  .btn--ghost:hover { border-color: var(--ink); }
  .plate__weight {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-muted-text);
  }

  .plates__tip {
    text-align: center;
    font-size: var(--text-xs);
    color: var(--color-muted-text);
    margin-top: 2rem;
  }

  /* ── Onward ── */
  .onward {
    max-width: 1180px;
    margin: 0 auto;
    padding: 1.5rem 2rem 4rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .onward__card {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--rule);
    border-top: 3px solid var(--accent);
    text-decoration: none;
    color: var(--ink);
    background: color-mix(in srgb, var(--alkali-flat) 40%, transparent);
    transition: background 0.2s, transform 0.2s;
  }
  .onward__card:hover { background: var(--alkali-flat); transform: translateY(-2px); }
  .onward__k {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--canyon-bronze);
  }
  .onward__t { font-family: var(--font-display); font-weight: 700; }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .notes { grid-template-columns: 1fr; gap: 2rem; }
  }
  @media (max-width: 760px) {
    .sheet__inner { padding: 1.5rem 1rem 3rem; }
    .crumbs { margin-bottom: 2rem; }
    .sheet__coords { display: grid; grid-template-columns: 1fr 1fr; width: 100%; }
    .sheet__coords div { margin-right: 0; padding-left: 0; border-right: 0; }
