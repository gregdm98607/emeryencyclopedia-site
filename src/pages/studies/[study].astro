---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getAllStudies, getStudy } from '../../data/studies';
import { CHAPTERS } from '../../data/chapters';

export async function getStaticPaths() {
  return getAllStudies().map((study) => ({
    params: { study: study.slug },
    props: { study },
  }));
}

const { study } = Astro.props;

// All articles in this study, ordered by seriesOrder then publish date.
const allArticles = await getCollection('articles');
const studyArticles = allArticles
  .filter((a) => a.data.series === study.slug)
  .sort((a, b) => {
    const oa = a.data.seriesOrder ?? Infinity;
    const ob = b.data.seriesOrder ?? Infinity;
    if (oa !== ob) return oa - ob;
    return (a.data.publishDate || '').localeCompare(b.data.publishDate || '');
  });

const kindLabel: Record<string, string> = {
  vignette: 'Vignette',
  teaser: 'Teaser',
  companion: 'Companion Article',
  essay: 'Essay',
};
---

<BaseLayout title={study.title} description={study.description}>
  <div class="study" style={`--study-color: ${study.color}`}>
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/studies/">One Place Studies</a>
      <span>/</span>
      <span>{study.shortLabel}</span>
    </nav>

    <header class="study-hero">
      <div class="study-hero__place">{study.place}</div>
      <h1>{study.title}</h1>
      <p class="study-hero__intro">{study.intro}</p>
    </header>

    {studyArticles.length === 0 ? (
      <p class="empty">No articles published in this study yet. Check back soon.</p>
    ) : (
      <div class="study-articles">
        {studyArticles.map((article) => {
          const ch = article.data.companionToChapter
            ? CHAPTERS.find((c) => c.number === article.data.companionToChapter)
            : null;
          return (
            <a href={`/articles/${article.id}/`} class="study-article-card">
              <div class="study-article-card__kind">
                {kindLabel[article.data.kind ?? 'vignette'] ?? 'Article'}
                {ch && (
                  <span class="study-article-card__ch">
                    {' '}&middot; Ch{article.data.companionToChapter}: {ch.title}
                  </span>
                )}
              </div>
              <h2 class="study-article-card__title">{article.data.title}</h2>
              <p class="study-article-card__description">{article.data.description}</p>
              <div class="study-article-card__meta">
                {article.data.readingTime}
                {article.data.publishDate && ` · ${article.data.publishDate}`}
              </div>
            </a>
          );
        })}
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .study {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 2rem 3rem;
  }
  .breadcrumb {
    font-size: 0.875rem;
    color: var(--color-text-muted, #777);
    margin-bottom: 2rem;
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .breadcrumb a {
    color: var(--color-accent-primary, #C85A54);
    text-decoration: none;
  }
  .breadcrumb a:hover { text-decoration: underline; }

  .study-hero {
    border-left: 4px solid var(--study-color, #C85A54);
    padding-left: 1.25rem;
    margin-bottom: 2.5rem;
  }
  .study-hero__place {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--study-color, #C85A54);
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  .study-hero h1 {
    font-family: var(--font-display, 'Libre Baskerville', serif);
    font-size: 2.5rem;
    margin: 0 0 1rem;
    line-height: 1.2;
  }
  .study-hero__intro {
    font-size: 1.0625rem;
    color: var(--color-text-muted, #444);
    line-height: 1.7;
    max-width: 68ch;
    margin: 0;
  }

  .empty {
    padding: 2rem 0;
    color: var(--color-text-muted, #777);
  }

  .study-articles {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .study-article-card {
    display: block;
    padding: 1.5rem;
    background: #fff;
    border: 1px solid var(--color-border-light, #e5e5e5);
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .study-article-card:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    transform: translateY(-1px);
  }
  .study-article-card__kind {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent-primary, #C85A54);
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  .study-article-card__ch {
    color: var(--color-text-muted, #777);
    font-weight: normal;
  }
  .study-article-card__title {
    font-family: var(--font-display, 'Libre Baskerville', serif);
    font-size: 1.375rem;
    margin: 0 0 0.5rem;
    line-height: 1.3;
  }
  .study-article-card__description {
    margin: 0 0 0.75rem;
    color: var(--color-text-muted, #555);
    line-height: 1.5;
  }
  .study-article-card__meta {
    font-size: 0.8125rem;
    color: var(--color-text-muted, #777);
  }
  @media (max-width: 640px) {
    .study { padding: 1.5rem 1rem 2rem; }
    .study-hero h1 { font-size: 1.75rem; }
  }
</style>
