.DS_Store

# jetbrains setting folder
.idea/

# Claude Code artifacts
.claude/

# Image curation staging area — local workflow artifact, not a site asset.
# Lives OUTSIDE public/ so staged/rejected images can never be deployed and
# approved-but-unincorporated images never appear as git deletions.
image-curation/

# auto-sync / PR coordination sentinel — never commit (see Git Auto Push + Auto Deploy Monitor)
.autosync-pause

# Local figure staging — original graphics awaiting review.
# Mirrors image-curation/. Only copies incorporated into
# public/images/chapters/ are tracked and deployed.
figure-curation/
